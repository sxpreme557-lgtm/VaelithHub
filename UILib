                    local stroke = Instance.new("UIStroke");
                    stroke.Color = themeRegistry.Preset.Accent;
                    stroke.Thickness = 1;
                    stroke.Parent = button;

                    window.MinimiseButton = button;
                    window.MinimiseGui = gui;

                    -- Destroyed with everything else on Unload.
                    table.insert(Library.Bin, gui);

                    local dragging, dragFrom, dragOrigin, moved = false, nil, nil, 0;

                    local function toggle()
                        Library:SetMenuVisible(not Library.Window.Open);
                        button.Text = Library.Window.Open and "V" or "+";
                    end;

                    button.InputBegan:Connect(function(input)
                        if input.UserInputType ~= Enum.UserInputType.MouseButton1
                            and input.UserInputType ~= Enum.UserInputType.Touch then
                            return;
                        end;

                        dragging = true;
                        moved = 0;
                        dragFrom = input.Position;
                        dragOrigin = button.Position;
                    end);

                    Services.UserInputService.InputChanged:Connect(function(input)
                        if not dragging then return end;

                        if input.UserInputType ~= Enum.UserInputType.MouseMovement
                            and input.UserInputType ~= Enum.UserInputType.Touch then
                            return;
                        end;

                        local delta = input.Position - dragFrom;
                        moved = math.max(moved, math.abs(delta.X) + math.abs(delta.Y));

                        button.Position = UDim2.new(
                            dragOrigin.X.Scale, dragOrigin.X.Offset + delta.X,
                            dragOrigin.Y.Scale, dragOrigin.Y.Offset + delta.Y);
                    end);

                    Services.UserInputService.InputEnded:Connect(function(input)
                        if not dragging then return end;

                        if input.UserInputType ~= Enum.UserInputType.MouseButton1
                            and input.UserInputType ~= Enum.UserInputType.Touch then
                            return;
                        end;

                        dragging = false;

                        -- Barely moved, so it was a tap rather than a drag.
                        if moved <= 6 then
                            toggle();
                        end;
                    end);
                end);

                if not ok then
                    warn("[Library] minimise button could not be created");
                end;
            end;

            return setmetatable(window, Library);
        end;
